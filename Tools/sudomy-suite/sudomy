### ── Passive Enumeration ────────────────────────────────────────────────────

# All active source names (functions)
ALL_SOURCES=(
  SHODAN WEBARCHIVE DNSDUMPSTER VIRUSTOTAL CERTSPOTTER CERTSH
  BINARYEDGE SECURITY_TRAILS CENSYS THREATMINER BUFFEROVER
  HACKERTARGET SPYSE THREATCROWD RIDDLER RAPIDDNS ALIENVAULT
  COMMONCRAWL URLSCAN DNSDB RISKIQ FBCERT CHAOS LEAKIX NETLAS
)

echo -e "${BOLD}[+]${RESET} Starting passive enumeration\n"
echo "────────────────────────────────────────────────────"

run_source_safely() {
  local fn="${1}"
  if declare -f "${fn}" > /dev/null 2>&1; then
    "${fn}" 2>/dev/null || true
  fi
}

if [[ "${SOURCE}" == true ]]; then
  # Run only selected sources
  for src in $(echo "${LIST}" | tr ',' '\n' | tr '[:upper:]' '[:lower:]'); do
    fn_upper="${src^^}"
    run_source_safely "${fn_upper}" &
  done
  wait

elif [[ "${SOURCE}" != "none" ]]; then
  # Run all sources in parallel with a job cap
  job_count=0
  for src_fn in "${ALL_SOURCES[@]}"; do
    run_source_safely "${src_fn}" &
    (( job_count++ ))
    if [[ ${job_count} -ge ${MAX_PARALLEL_JOBS} ]]; then
      wait
      job_count=0
    fi
  done
  wait
fi

### ── Merge & Deduplicate ────────────────────────────────────────────────────

ARG_PARS_LIST() {
  echo -e "\n${BOLD}[+]${RESET} Merging & deduplicating results\n"
  echo "────────────────────────────────────────────────────"

  # Combine all .log files
  find "${OUT}" -maxdepth 1 -name "*.log" -type f 2>/dev/null | \
    xargs cat 2>/dev/null | \
    sed 's/\*\.//g' | \
    tr '[:upper:]' '[:lower:]' | \
    grep -E "^[a-zA-Z0-9._-]+\.${DOMAIN//./\\.}$" | \
    sort -u > "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"

  # Clean up temp logs
  find "${OUT}" -maxdepth 1 -name "*.log" -type f -delete 2>/dev/null
  find "${OUT}" -maxdepth 1 -name "*.tmp" -type f -delete 2>/dev/null

  local count=0
  if [[ -f "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}" ]]; then
    count=$(wc -l < "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}")
  fi

  echo -e "${PADDING}${GREEN}[✓]${RESET} Total unique subdomains: ${LGREEN}${count}${RESET}"
  echo -e "${PADDING}${YELLOW}⍥${RESET} Saved → ${DOMAIN_DIR}/${RESULT_SUBDOMAIN}\n"

  if [[ "${verbose}" == true ]] && [[ -f "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}" ]]; then
    while IFS= read -r sub; do
      echo -e "${PADDING}  - ${sub}"
    done < "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"
  fi
}

ARG_PARS_LIST

### ── Permutation Enumeration ────────────────────────────────────────────────

if [[ "${PLUGIN_PERMUTE}" == true ]]; then
  echo -e "${BOLD}[+]${RESET} Running smart permutation engine\n"
  echo "────────────────────────────────────────────────────"

  PERM_OUT="${DOMAIN_DIR}/${RESULT_PERMUTATIONS}"
  python3 "${SCRIPT_DIR}/lib/permutation_engine.py" \
    -i "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}" \
    -d "${DOMAIN}" \
    -o "${PERM_OUT}" 2>&1

  if [[ -f "${PERM_OUT}" ]]; then
    PERM_RESOLVED="${DOMAIN_DIR}/permutation_resolved.txt"
    echo -e "${PADDING}${YELLOW}⍥${RESET} Resolving permutations via mass_resolver..."
    python3 "${SCRIPT_DIR}/lib/mass_resolver.py" \
      -i "${PERM_OUT}" \
      -d "${DOMAIN}" \
      -o "${PERM_RESOLVED}" \
      --live-only -v 2>&1

    if [[ -f "${PERM_RESOLVED}" ]]; then
      PERM_COUNT=$(wc -l < "${PERM_RESOLVED}")
      echo -e "${PADDING}${GREEN}[✓]${RESET} Permutation: ${LGREEN}${PERM_COUNT}${RESET} new live subdomains"
      # Merge into master list
      cat "${PERM_RESOLVED}" >> "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"
      sort -u "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}" -o "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"
    fi
  fi
fi

### ── DNS Bruteforce (gobuster) ──────────────────────────────────────────────

if [[ "${PLUGIN_GOBUSTER}" == true ]]; then
  echo -e "${BOLD}[+]${RESET} DNS Bruteforce (gobuster)\n"
  echo "────────────────────────────────────────────────────"

  if command -v gobuster &>/dev/null && [[ -f "${_GOWORDLIST}" ]]; then
    gobuster dns \
      -d "${DOMAIN}" \
      -w "${_GOWORDLIST}" \
      -t 50 \
      -o "${DOMAIN_DIR}/${OUT_GOBUSTER}" \
      --no-error \
      2>/dev/null

    if [[ -f "${DOMAIN_DIR}/${OUT_GOBUSTER}" ]]; then
      grep -oE '[a-zA-Z0-9._-]+\.'"${DOMAIN//./\\.}" "${DOMAIN_DIR}/${OUT_GOBUSTER}" | \
        sort -u >> "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"
      sort -u "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}" -o "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"
      BFCOUNT=$(wc -l < "${DOMAIN_DIR}/${OUT_GOBUSTER}")
      echo -e "${PADDING}${GREEN}[✓]${RESET} Bruteforce found ${LGREEN}${BFCOUNT}${RESET} subdomains"
    fi
  else
    echo -e "${PADDING}${YELLOW}[~]${RESET} gobuster or wordlist not found — skipping"
  fi
fi

### ── Mass DNS Resolver ──────────────────────────────────────────────────────

if [[ "${PLUGIN_RESOLV_SD}" == true ]]; then
  echo -e "\n${BOLD}[+]${RESET} Resolving subdomains → IPs\n"
  echo "────────────────────────────────────────────────────"

  RESOLVER_OUT="${DOMAIN_DIR}/${RESULT_MASSDNS}"
  python3 "${SCRIPT_DIR}/lib/mass_resolver.py" \
    -i "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}" \
    -d "${DOMAIN}" \
    -r "${DNS_RESOLVERS_FILE}" \
    -o "${RESOLVER_OUT}" \
    -t 200 -v 2>&1

  if [[ -f "${RESOLVER_OUT}" ]]; then
    # Also create the simple IP list for compat
    awk '{print $2}' "${RESOLVER_OUT}" | tr ',' '\n' | \
      grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | \
      sort -u > "${DOMAIN_DIR}/${RESULT_IP_RESOLVER}"
    # And the live-only subdomain list
    awk '{print $1}' "${RESOLVER_OUT}" | sort -u > "${DOMAIN_DIR}/${FINAL_SUBDOMAIN_REV_ALL}"
    LIVE_COUNT=$(wc -l < "${DOMAIN_DIR}/${FINAL_SUBDOMAIN_REV_ALL}")
    echo -e "${PADDING}${GREEN}[✓]${RESET} Live subdomains: ${LGREEN}${LIVE_COUNT}${RESET}"
  fi
fi

### ── HTTP Probe (httprobe) ──────────────────────────────────────────────────

if [[ "${PLUGIN_HTTPROBE}" == true ]]; then
  echo -e "\n${BOLD}[+]${RESET} HTTP probe (httprobe)\n"
  echo "────────────────────────────────────────────────────"

  PROBE_INPUT="${DOMAIN_DIR}/${FINAL_SUBDOMAIN_REV_ALL:-${RESULT_SUBDOMAIN}}"
  [[ ! -f "${PROBE_INPUT}" ]] && PROBE_INPUT="${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"

  if command -v httprobe &>/dev/null && [[ -f "${PROBE_INPUT}" ]]; then
    cat "${PROBE_INPUT}" | \
      httprobe -c 50 -t 10000 \
      > "${DOMAIN_DIR}/${RESULT_HTTPROBE}" 2>/dev/null
    HTTP_COUNT=$(wc -l < "${DOMAIN_DIR}/${RESULT_HTTPROBE}" 2>/dev/null || echo 0)
    echo -e "${PADDING}${GREEN}[✓]${RESET} Live HTTP endpoints: ${LGREEN}${HTTP_COUNT}${RESET}"
  else
    echo -e "${PADDING}${YELLOW}[~]${RESET} httprobe not found — skipping"
  fi
fi

