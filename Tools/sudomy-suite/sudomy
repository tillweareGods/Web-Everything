_check_dep() {
  local cmd="${1}"
  command -v "${cmd}" &>/dev/null || {
    echo -e "${RED}[!]${RESET} Required dependency '${cmd}' not found. Run: ./install.sh" >&2
    exit 1
  }
}

_check_dep "curl"
_check_dep "jq"
_check_dep "dig"
_check_dep "python3"
_check_dep "sort"

# Check optional tools gracefully
_warn_dep() {
  local cmd="${1}" msg="${2}"
  command -v "${cmd}" &>/dev/null || \
    echo -e "${YELLOW}[~]${RESET} Optional tool '${cmd}' not found — ${msg}"
}

