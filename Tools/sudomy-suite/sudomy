fi

### ── dnsx ───────────────────────────────────────────────────────────────────

if [[ "${PLUGIN_DNSX}" == true ]]; then
  echo -e "\n${BOLD}[+]${RESET} dnsx DNS queries\n"
  echo "────────────────────────────────────────────────────"

  PROBE_INPUT="${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"
  if command -v dnsx &>/dev/null && [[ -f "${PROBE_INPUT}" ]]; then
    dnsx -l "${PROBE_INPUT}" \
      -a -cname -resp \
      -o "${DOMAIN_DIR}/${RESULT_DNSX}" \
      -silent -t 50 2>/dev/null
    DNSX_COUNT=$(wc -l < "${DOMAIN_DIR}/${RESULT_DNSX}" 2>/dev/null || echo 0)
    echo -e "${PADDING}${GREEN}[✓]${RESET} dnsx resolved: ${LGREEN}${DNSX_COUNT}${RESET}"
  else
    echo -e "${PADDING}${YELLOW}[~]${RESET} dnsx not found — skipping"
  fi
fi

### ── Subdomain Takeover ─────────────────────────────────────────────────────

if [[ "${PLUGIN_TAKEOVER}" == true ]]; then
  echo -e "\n${BOLD}[+]${RESET} Takeover scanner\n"
  echo "────────────────────────────────────────────────────"

  TAKEOVER_DIR="${DOMAIN_DIR}/takeover"
  mkdir -p "${TAKEOVER_DIR}"
  PROBE_INPUT="${DOMAIN_DIR}/${FINAL_SUBDOMAIN_REV_ALL:-${RESULT_SUBDOMAIN}}"
  [[ ! -f "${PROBE_INPUT}" ]] && PROBE_INPUT="${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"

  python3 "${SCRIPT_DIR}/lib/takeover_scanner.py" \
    -i "${PROBE_INPUT}" \
    -o "${TAKEOVER_DIR}/${RESULT_TAKEOVER}" \
    -t 50 2>&1
fi

### ── Ping Sweep ─────────────────────────────────────────────────────────────

if [[ "${PLUGIN_PING_SWEEP}" == true ]]; then
  echo -e "\n${BOLD}[+]${RESET} Ping sweep\n"
  echo "────────────────────────────────────────────────────"

  if [[ -f "${DOMAIN_DIR}/${RESULT_IP_RESOLVER}" ]]; then
    : > "${DOMAIN_DIR}/${RESULT_PINGSWEEP}"
    while IFS= read -r ip; do
      [[ -z "${ip}" ]] && continue
      if ping -c 1 -W 2 "${ip}" &>/dev/null; then
        echo "${ip} LIVE" >> "${DOMAIN_DIR}/${RESULT_PINGSWEEP}"
      else
        echo "${ip} DOWN" >> "${DOMAIN_DIR}/${RESULT_PINGSWEEP}"
      fi
    done < "${DOMAIN_DIR}/${RESULT_IP_RESOLVER}"

    LIVE=$(grep -c " LIVE" "${DOMAIN_DIR}/${RESULT_PINGSWEEP}" 2>/dev/null || echo 0)
    mv "${DOMAIN_DIR}/${RESULT_PINGSWEEP}" "${DOMAIN_DIR}/${FINAL_PINGSWEEP}"
    echo -e "${PADDING}${GREEN}[✓]${RESET} Live IPs: ${LGREEN}${LIVE}${RESET}"
  else
    echo -e "${PADDING}${YELLOW}[~]${RESET} No IP resolver results — run -rS first"
  fi
fi

### ── Status Code Check ──────────────────────────────────────────────────────

if [[ "${PLUGIN_STATUS_CODE}" == true ]]; then
  echo -e "\n${BOLD}[+]${RESET} HTTP status codes\n"
  echo "────────────────────────────────────────────────────"

  PROBE_INPUT="${DOMAIN_DIR}/${RESULT_HTTPROBE:-${RESULT_SUBDOMAIN}}"
  [[ ! -f "${PROBE_INPUT}" ]] && PROBE_INPUT="${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"

  if [[ -f "${PROBE_INPUT}" ]]; then
    : > "${DOMAIN_DIR}/${RESULT_HTTP_CODE}"
    while IFS= read -r url; do
      [[ -z "${url}" ]] && continue
      # Ensure URL has scheme
      [[ "${url}" != http* ]] && url="http://${url}"
      code=$(curl -sk --max-time 10 -o /dev/null -w "%{http_code}" \
        -A "Mozilla/5.0 (compatible; Sudomy/2.0)" "${url}" 2>/dev/null)
      echo "${url} ${code}" >> "${DOMAIN_DIR}/${RESULT_HTTP_CODE}"
    done < "${PROBE_INPUT}"

    count_200=$(grep -c " 200" "${DOMAIN_DIR}/${RESULT_HTTP_CODE}" 2>/dev/null || echo 0)
    cp "${DOMAIN_DIR}/${RESULT_HTTP_CODE}" "${DOMAIN_DIR}/${FINAL_HTTP_CODE}"
    echo -e "${PADDING}${GREEN}[✓]${RESET} HTTP 200 responses: ${LGREEN}${count_200}${RESET}"
  fi
fi

### ── Nmap Top Ports ─────────────────────────────────────────────────────────

if [[ "${PLUGIN_NMAP_PORTS}" == true ]]; then
  echo -e "\n${BOLD}[+]${RESET} Nmap top-ports scan\n"
  echo "────────────────────────────────────────────────────"

  if command -v nmap &>/dev/null && [[ -f "${DOMAIN_DIR}/${RESULT_IP_RESOLVER}" ]]; then
    nmap --top-ports 1000 \
      -iL "${DOMAIN_DIR}/${RESULT_IP_RESOLVER}" \
      -oN "${DOMAIN_DIR}/${RESULT_NMAP_HOSTS}" \
      -T4 --open -Pn 2>/dev/null
    echo -e "${PADDING}${GREEN}[✓]${RESET} Nmap scan complete → ${RESULT_NMAP_HOSTS}"
  else
    echo -e "${PADDING}${YELLOW}[~]${RESET} nmap not found or no IPs to scan"
  fi
fi

### ── Cloudflare Check ───────────────────────────────────────────────────────

if [[ "${PLUGIN_CFCHECK}" == true ]]; then
  echo -e "\n${BOLD}[+]${RESET} Cloudflare detection\n"
  echo "────────────────────────────────────────────────────"

  if command -v cf-check &>/dev/null && [[ -f "${DOMAIN_DIR}/${RESULT_IP_RESOLVER}" ]]; then
    cf-check -l "${DOMAIN_DIR}/${RESULT_IP_RESOLVER}" \
      > "${DOMAIN_DIR}/${RESULT_CFCHECK}" 2>/dev/null
    echo -e "${PADDING}${GREEN}[✓]${RESET} Cloudflare check complete"
  else
    echo -e "${PADDING}${YELLOW}[~]${RESET} cf-check not found or no IPs — skipping"
  fi
fi

### ── Screenshots ────────────────────────────────────────────────────────────

if [[ "${PLUGIN_GOWITNESS}" == true ]]; then
  echo -e "\n${BOLD}[+]${RESET} Screenshots (gowitness)\n"
  echo "────────────────────────────────────────────────────"

  SS_DIR="${DOMAIN_DIR}/screenshots"
  mkdir -p "${SS_DIR}"
  PROBE_INPUT="${DOMAIN_DIR}/${RESULT_HTTPROBE}"
  [[ ! -f "${PROBE_INPUT}" ]] && PROBE_INPUT="${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"

  if command -v gowitness &>/dev/null && [[ -f "${PROBE_INPUT}" ]]; then
    gowitness file -f "${PROBE_INPUT}" \
      --screenshot-path "${SS_DIR}" \
      --timeout 15 \
      --threads 10 2>/dev/null
    SS_COUNT=$(find "${SS_DIR}" -name "*.png" 2>/dev/null | wc -l)
    echo -e "${PADDING}${GREEN}[✓]${RESET} Screenshots taken: ${LGREEN}${SS_COUNT}${RESET}"
  else
    echo -e "${PADDING}${YELLOW}[~]${RESET} gowitness not found — skipping"
  fi
fi

### ── Slack Notification ─────────────────────────────────────────────────────

if [[ "${SLACK}" == true && "${_SLACK_NOTIFY}" == true ]]; then
  TOTAL=$(wc -l < "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}" 2>/dev/null || echo 0)
  PAYLOAD="{\"text\":\"[Sudomy] Scan complete for *${DOMAIN}*\\n• Subdomains: ${TOTAL}\"}"
  curl -s -X POST -H "Content-type: application/json" \
    --data "${PAYLOAD}" "${SLACK_WEBHOOK_URL}" &>/dev/null
  echo -e "${PADDING}${GREEN}[✓]${RESET} Slack notification sent"
fi

### ── Final Summary ──────────────────────────────────────────────────────────

echo -e "\n════════════════════════════════════════════════════"
echo -e "${BOLD}[+]${RESET} Sudomy v2.0 — Scan Complete"
echo -e "════════════════════════════════════════════════════\n"

_print_count() {
  local label="${1}" file="${2}" grep_pattern="${3:-}"
  local count=0
  if [[ -f "${file}" ]]; then
    if [[ -n "${grep_pattern}" ]]; then
      count=$(grep -c "${grep_pattern}" "${file}" 2>/dev/null || echo 0)
    else
      count=$(wc -l < "${file}" 2>/dev/null || echo 0)
    fi
  fi
  printf "  ${YELLOW}⍥${RESET} %-28s ${LGREEN}%s${RESET}\n" "${label}" "${count}"
}

_print_count "Subdomains discovered"     "${DOMAIN_DIR}/${RESULT_SUBDOMAIN}"
_print_count "Resolved (live DNS)"       "${DOMAIN_DIR}/${FINAL_SUBDOMAIN_REV_ALL}"
_print_count "Unique IPs"                "${DOMAIN_DIR}/${RESULT_IP_RESOLVER}"
_print_count "HTTP probe (live)"         "${DOMAIN_DIR}/${RESULT_HTTPROBE}"
_print_count "HTTP 200 responses"        "${DOMAIN_DIR}/${FINAL_HTTP_CODE}" " 200"
_print_count "Takeover (vulnerable)"     "${DOMAIN_DIR}/takeover/${RESULT_TAKEOVER}" "Vulnerable\|HIGH\|MEDIUM"
_print_count "Live hosts (ping)"         "${DOMAIN_DIR}/${FINAL_PINGSWEEP}" "LIVE"

echo -e "\n  ${YELLOW}⍥${RESET} Output directory: ${LGREEN}${DOMAIN_DIR}${RESET}"
[[ "${REPORTS}" == 1 ]] && echo -e "  ${YELLOW}⍥${RESET} HTML report:      ${LGREEN}${DOMAIN_DIR}/report${RESET}"
echo ""

### ── Copy to destination ────────────────────────────────────────────────────

if [[ "${DESTINATION}" == true ]]; then
  [[ ! -d "${OUTFILE}" ]] && mkdir -p "${OUTFILE}"
  cp -r "${DOMAIN_DIR}" "${OUTFILE}/"
  echo -e "  ${GREEN}[✓]${RESET} Copied to: ${OUTFILE}/${DOMAIN}"
fi
